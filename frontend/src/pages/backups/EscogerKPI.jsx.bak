import { useState, useEffect, useMemo } from "react";
import { kpiService } from "../services/kpiService";

const STATUS_FILTERS = [
  { value: "all", label: "Todos" },
  { value: "active", label: "Activos" },
  { value: "inactive", label: "Inactivos" },
];

export default function EscogerKPI() {
  const [areas, setAreas] = useState([]);
  const [selectedArea, setSelectedArea] = useState("");
  const [searchTerm, setSearchTerm] = useState("");
  const [viewMode, setViewMode] = useState("all");

  const [kpisData, setKpisData] = useState(null); // Guardará la respuesta del endpoint /semanales
  const [loading, setLoading] = useState(false);
  const [feedback, setFeedback] = useState(null);

  const clearFeedback = () => setFeedback(null);

  // 1. Cargar áreas al inicio
  useEffect(() => {
    kpiService
      .getAreasStats()
      .then(setAreas)
      .catch(() =>
        setFeedback({ tipo: "error", mensaje: "Error al cargar áreas" }),
      );
  }, []);

  // 2. Cargar KPIs cuando se selecciona un área
  const handleAreaChange = async (e) => {
    const areaId = e.target.value;
    setSelectedArea(areaId);
    setKpisData(null);
    setSearchTerm("");
    setViewMode("all");
    clearFeedback();

    if (!areaId) return;

    setLoading(true);
    try {
      const data = await kpiService.getKpisSemanales(areaId);
      setKpisData(data);
    } catch (err) {
      setFeedback({
        tipo: "error",
        mensaje: "Error al cargar los KPIs del área",
      });
    } finally {
      setLoading(false);
    }
  };

  const filteredKpis = useMemo(() => {
    if (!kpisData?.kpis) return [];

    return kpisData.kpis.filter((kpi) => {
      const matchesSearch = kpi.nombre
        .toLowerCase()
        .includes(searchTerm.toLowerCase());

      if (viewMode === "active") return matchesSearch && kpi.activo_semanal;
      if (viewMode === "inactive") return matchesSearch && !kpi.activo_semanal;
      return matchesSearch;
    });
  }, [kpisData, searchTerm, viewMode]);

  // 3. Activar/Desactivar KPI
  const handleToggle = async (kpiId, actualEstado) => {
    if (!kpisData) return;

    // Si queremos activar y ya hay 3, prevenimos desde el frontend (el backend también lo bloquea)
    if (!actualEstado && kpisData.activos_count >= kpisData.max_activos) {
      setFeedback({
        tipo: "error",
        mensaje: `Máximo ${kpisData.max_activos} KPIs permitidos por semana.`,
      });
      return;
    }

    try {
      clearFeedback();
      await kpiService.activarKpi(kpiId);

      // Recargar la lista para tener el conteo y estados actualizados
      const data = await kpiService.getKpisSemanales(selectedArea);
      setKpisData(data);
      setFeedback({
        tipo: "ok",
        mensaje: "Estado actualizado correctamente.",
      });
    } catch (err) {
      const msg =
        err?.response?.data?.detail || "Error al cambiar estado del KPI";
      setFeedback({ tipo: "error", mensaje: msg });
    }
  };

  const activeRatio = kpisData
    ? Math.round((kpisData.activos_count / Math.max(1, kpisData.max_activos)) * 100)
    : 0;

  return (
    <div className="max-w-4xl mx-auto bg-white rounded-3xl shadow-sm border border-slate-200 p-8">
      <div className="mb-6 border-b border-slate-100 pb-5">
        <h2 className="text-2xl font-extrabold text-azul-profundo">
          Selección de KPIs Semanales
        </h2>
        <p className="text-sm text-slate-500 mt-2">
          Activa los KPIs más relevantes para tu área y mantén al equipo enfocado.
        </p>
      </div>

      {feedback && (
        <div
          className={`mb-6 px-4 py-3 rounded-2xl text-sm font-medium border ${
            feedback.tipo === "ok"
              ? "bg-azul/10 border-azul/20 text-azul-profundo"
              : "bg-red-50 border-red-200 text-red-700"
          }`}
        >
          {feedback.mensaje}
        </div>
      )}

      <div className="grid gap-8 lg:grid-cols-[1.2fr_0.8fr]">
        <div className="space-y-6">
          <div className="rounded-3xl border border-slate-200 p-6 bg-slate-50/70 shadow-sm">
            <label className="block text-sm font-bold text-azul-profundo mb-3">
              Área a configurar
            </label>
            <select
              className="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-azul focus:ring-2 focus:ring-azul/10"
              value={selectedArea}
              onChange={handleAreaChange}
            >
              <option value="">-- Seleccionar --</option>
              {areas.map((a) => (
                <option key={a.id} value={a.id}>
                  {a.nombre}
                </option>
              ))}
            </select>
          </div>

          {kpisData && (
            <div className="rounded-3xl border border-slate-200 p-6 bg-white shadow-sm">
              <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <p className="text-xs uppercase tracking-[0.24em] text-azul font-black mb-2">
                    Estado semanal
                  </p>
                  <div className="flex items-center gap-3 text-sm font-bold text-azul-profundo">
                    <span>{kpisData.activos_count} / {kpisData.max_activos} activados</span>
                    <span className="rounded-full bg-azul/10 px-3 py-1 text-xs font-semibold text-azul">
                      {activeRatio}% objetivo
                    </span>
                  </div>
                </div>
                <div className="w-full sm:max-w-sm">
                  <div className="h-3 rounded-full bg-slate-200 overflow-hidden">
                    <div
                      className="h-full rounded-full bg-azul transition-all duration-500"
                      style={{ width: `${activeRatio}%` }}
                    />
                  </div>
                </div>
              </div>

              <div className="mt-5 grid gap-2 sm:grid-cols-3">
                {STATUS_FILTERS.map((filter) => (
                  <button
                    key={filter.value}
                    type="button"
                    onClick={() => setViewMode(filter.value)}
                    className={`rounded-2xl border px-4 py-2 text-sm font-semibold transition ${
                      viewMode === filter.value
                        ? "border-azul bg-azul text-white"
                        : "border-slate-200 bg-white text-slate-600 hover:border-azul/50"
                    }`}
                  >
                    {filter.label}
                  </button>
                ))}
              </div>

              <div className="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600">
                <p className="font-semibold text-slate-700 mb-1">Consejo rápido</p>
                <p>
                  Usa la búsqueda y los filtros para encontrar el KPI exacto, luego activa o desactiva con un simple clic.
                </p>
              </div>
            </div>
          )}
        </div>

        <div className="space-y-6">
          <div className="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
            <div className="flex items-center justify-between gap-4">
              <div>
                <p className="text-xs uppercase tracking-[0.24em] text-slate-400 mb-1">
                  Filtrado interactivo
                </p>
                <h3 className="text-lg font-bold text-azul-profundo">Encuentra tu KPI</h3>
              </div>
            </div>

            <label className="mt-6 block text-sm font-bold text-slate-700 mb-2">
              Buscar KPI
            </label>
            <input
              type="search"
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              placeholder="Busca por nombre..."
              className="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm outline-none transition focus:border-azul focus:ring-2 focus:ring-azul/10"
            />

            <div className="mt-6 rounded-3xl border border-slate-200 bg-azul/5 p-4 text-sm text-slate-600">
              <p className="font-semibold text-slate-800">Atajo visual</p>
              <p className="mt-2">
                Las tarjetas se despliegan con colores suaves para indicar el estado actual del KPI y el botón te muestra si está activo o no.
              </p>
            </div>
          </div>
        </div>
      </div>

      {loading ? (
        <div className="text-center py-10 text-slate-500">
          Cargando KPIs...
        </div>
      ) : kpisData ? (
        <div className="mt-8 space-y-4">
          {filteredKpis.length > 0 ? (
            filteredKpis.map((kpi) => (
              <div
                key={kpi.id}
                className={`group flex flex-col gap-5 rounded-3xl border p-5 shadow-sm transition hover:-translate-y-0.5 ${
                  kpi.activo_semanal
                    ? "border-azul/20 bg-azul/5"
                    : "border-slate-200 bg-white hover:border-azul/30"
                }`}>
                <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                  <div>
                    <div className="flex items-center gap-2">
                      <span className={`text-xs font-semibold uppercase tracking-[0.24em] ${kpi.activo_semanal ? "text-azul" : "text-slate-400"}`}>
                        {kpi.activo_semanal ? "Activo" : "Inactivo"}
                      </span>
                      {kpi.activo_semanal && (
                        <span className="rounded-full bg-turquesa/10 px-2 py-1 text-[11px] font-semibold text-turquesa">
                          Prioridad semanal
                        </span>
                      )}
                    </div>
                    <h4 className="mt-3 text-lg font-bold text-azul-profundo">{kpi.nombre}</h4>
                    <p className="mt-2 text-sm text-slate-600 font-mono">{kpi.formula_texto || "Sin fórmula"}</p>
                  </div>

                  <button type="button" onClick={() => handleToggle(kpi.id, kpi.activo_semanal)} aria-pressed={kpi.activo_semanal} className={`inline-flex items-center justify-center rounded-full px-5 py-3 text-sm font-semibold transition ${kpi.activo_semanal ? "bg-azul text-white shadow-lg shadow-azul/10" : "border border-slate-300 bg-white text-azul hover:border-azul/50"}`}>
                    {kpi.activo_semanal ? "Desactivar" : "Activar"}
                  </button>
                </div>

                <div className="flex flex-wrap items-center gap-3 text-xs text-slate-500">
                  <span className="rounded-full border border-slate-200 bg-slate-100 px-3 py-1">ID {kpi.id}</span>
                  <span className="rounded-full border border-slate-200 bg-slate-100 px-3 py-1">{kpi.tipo || "Tipo desconocido"}</span>
                  <span className="rounded-full border border-slate-200 bg-slate-100 px-3 py-1">{kpi.activo_semanal ? "Listo para la semana" : "Disponible para activar"}</span>
                </div>
              </div>
            ))
          ) : (
            <div className="rounded-3xl border border-slate-200 bg-slate-50 p-8 text-center text-slate-500">
              <p className="font-semibold text-slate-700 mb-2">No se encontraron KPIs</p>
              <p>Prueba con otro filtro o cambia de área para ver más resultados.</p>
            </div>
          )}
        </div>
      ) : null}
    </div>
  );
}
